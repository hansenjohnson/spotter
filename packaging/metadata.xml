<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shaped to match testplugin_pi/Frontend2's real plugin.xml.in template
  field-for-field (cmake/in-files/plugin.xml.in in a current checkout),
  with each ${...} resolved by hand against this project's own
  CMakeLists.txt settings block, since this file isn't generated by
  actually running that build system's configure_file() step.

  Placeholders still needing a real value before catalog submission:
  <source>/<tarball-url> (needs the actual GitHub repo to exist and a
  real, hosted release tarball) and <target>/<build-target>/<build-gtk>/
  <target-version>/<target-arch> (currently describe only the macOS/
  arm64 build this project is actually developed and tested against;
  a real submission needs one of these files per supported platform).
-->
<plugin version="1">
  <name> Spotter </name>
  <version> 2.0.0.0 </version>
  <release> 0 </release>
  <summary> Wildlife survey logging: sightings, effort, events, and a trackline </summary>

  <api-version> 1.18 </api-version>
  <open-source> yes </open-source>
  <author> Hansen Johnson </author>
  <source> https://github.com/hansenjohnson/spotter </source>

  <description>
    Spotter is a logging tool for marine mammal and wildlife surveys
    aboard a vessel running OpenCPN. It records sightings, on/off-effort
    status and environmental conditions, and general events, alongside an
    automatically-recorded trackline -- all timestamped and geotagged from
    OpenCPN's own GPS feed, with configurable chart markers for sightings
    and events.
  </description>

  <target>darwin</target>
  <build-target>darwin</build-target>
  <build-gtk></build-gtk>
  <target-version>13</target-version>
  <target-arch>arm64</target-arch>
  <tarball-url>
    file:///dev/null
  </tarball-url>
  <info-url> https://github.com/hansenjohnson/spotter </info-url>
</plugin>
