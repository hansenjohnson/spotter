# For information on this file see: https://editorconfig.org
#
# C++ indentation/width here intentionally match .clang-format (2-space,
# Google style), not testplugin_pi's own .editorconfig -- that file
# contradicts its own .clang-format (4-space, latin1) for the same file
# types, so it isn't adopted verbatim here. UTF-8 used throughout rather
# than latin1, matching what every source file in this project already is.
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

[*.{cmake,cpp,h,sh,in,yml,xsd}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
