# Build output -- never committed. A stale CMakeCache.txt (which
# hardcodes the absolute path it was configured in) breaking CI on a
# completely different machine is exactly the kind of problem this
# exists to prevent; see dev.md for the specific incident.
build/
build-*/
cmake-build*/

# msvc/win_deps.bat's output -- a large, regeneratable, per-machine
# wxWidgets + opencpn.lib cache that has no business being committed.
cache/

# Also written by win_deps.bat -- libs/api-18/CMakeLists.txt (the
# vendored OpenCPN API headers) separately, independently expects
# opencpn.lib at this exact path for MSVC builds, so win_deps.bat
# copies it here too; same reasoning as cache/ above for not
# committing it.
libs/api-18/msvc-wx32/

# Editor/IDE noise
.vscode/
.idea/
.directory
*.swp
*~

# OS noise
.DS_Store
Thumbs.db

# From the real testplugin_pi's own .gitignore, kept for consistency
# where it still applies to this project.
po/POTFILES.in.test
temp
tmp
master.zip
